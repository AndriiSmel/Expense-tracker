{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "expense-tracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.personal.expensetracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.personal.expensetracker",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NunitoSans-Regular.ttf",
            "./assets/fonts/NunitoSans-SemiBold.ttf",
            "./assets/fonts/NunitoSans-Bold.ttf",
            "./assets/fonts/NunitoSans-Black.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "resizeMode": "contain"
        }
      ]
    ],
    "updates": {
      "enabled": false
    },
    "extra": {
      "eas": {
        "projectId": "9739022e-9f64-4f8e-b033-0d52ec798a63"
      },
      "router": {
        "origin": false,
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
